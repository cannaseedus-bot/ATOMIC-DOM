#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# ATOMIC EXPERT: lang-javascript-core
# VERSION: 1.0.0
# STATUS: FROZEN
# ═══════════════════════════════════════════════════════════════

EXPERT_ID="lang-javascript-core"
EXPERT_TITLE="JavaScript Core Expert"
EXPERT_JOB="Write modern JavaScript with ES6+ features, async/await, modules, and DOM manipulation"
EXPERT_PARENT="ProgrammingMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "javascript" "js" "ecmascript" "es6" "es2015" "es2020" "function"
  "arrow" "const" "let" "var" "async" "await" "promise" "callback"
  "closure" "hoisting" "scope" "prototype" "class" "constructor"
  "module" "import" "export" "default" "destructuring" "spread"
  "rest" "template" "literal" "symbol" "proxy" "reflect" "iterator"
  "generator" "map" "set" "weakmap" "weakset" "array" "object"
)

NGRAM_2=(
  "javascript code" "arrow function" "async function" "async await"
  "promise then" "callback function" "es6 module" "import export"
  "template literal" "destructuring assignment" "spread operator"
  "rest parameters" "prototype chain" "event loop" "call stack"
  "closure scope" "hoisting behavior" "strict mode" "dom manipulation"
  "event listener" "fetch api" "json parse" "local storage"
)

NGRAM_3=(
  "write javascript function" "create async function" "use arrow function"
  "handle promise rejection" "add event listener" "parse json data"
)

WEIGHT_ACTIVATION=0.55

declare -A WEIGHT_AFFINITY=(
  ["javascript"]=0.98 ["js"]=0.95 ["es6"]=0.88 ["async"]=0.85
  ["await"]=0.85 ["promise"]=0.88 ["arrow"]=0.82 ["closure"]=0.85
  ["prototype"]=0.82 ["module"]=0.78 ["import"]=0.75 ["export"]=0.75
  ["destructuring"]=0.85 ["spread"]=0.82 ["callback"]=0.80
)

WEIGHT_CONFIDENCE_MIN=0.70
WEIGHT_CONFIDENCE_MAX=0.96
WEIGHT_FLARE=0.25

declare -A FLARE_SECONDARY=(
  ["lang-typescript-core"]=0.45 ["web-react-core"]=0.40 ["web-vue-core"]=0.35
  ["web-html-semantic"]=0.30 ["web-css-layout"]=0.25
)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true
SANDBOX_NO_WRITE=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; *) echo "Usage: $0 {activate|score|status|info} [input]";; esac
