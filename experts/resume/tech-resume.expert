#!/bin/bash
# ATOMIC EXPERT: resume-tech-resume | VERSION: 1.0.0 | STATUS: FROZEN
EXPERT_ID="resume-tech-resume"
EXPERT_TITLE="Tech Resume Expert"
EXPERT_JOB="Create impactful technical resumes with quantified achievements and ATS optimization"
EXPERT_PARENT="ResumeMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "resume" "cv" "curriculum" "vitae" "experience" "skill" "skills"
  "achievement" "accomplishment" "project" "education" "certification"
  "summary" "objective" "bullet" "point" "quantify" "metric" "impact"
  "ats" "keyword" "format" "template" "section" "header"
)

NGRAM_2=(
  "tech resume" "software engineer resume" "developer resume" "resume format"
  "resume template" "work experience" "technical skills" "key achievements"
  "resume summary" "professional experience" "ats friendly" "ats optimization"
  "quantified achievement" "resume bullet" "resume section"
)

NGRAM_3=(
  "write tech resume" "optimize resume for" "quantify resume achievements"
  "ats friendly resume" "improve my resume"
)

WEIGHT_ACTIVATION=0.55
declare -A WEIGHT_AFFINITY=(
  ["resume"]=0.98 ["cv"]=0.92 ["experience"]=0.82 ["skill"]=0.78
  ["achievement"]=0.88 ["project"]=0.75 ["ats"]=0.90 ["quantify"]=0.85
  ["bullet"]=0.80 ["summary"]=0.75 ["certification"]=0.78 ["metric"]=0.82
)
WEIGHT_CONFIDENCE_MIN=0.70
WEIGHT_CONFIDENCE_MAX=0.94
WEIGHT_FLARE=0.18
declare -A FLARE_SECONDARY=(["resume-cover-letter"]=0.45 ["resume-linkedin-profile"]=0.40 ["resume-interview-prep"]=0.35)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; esac
