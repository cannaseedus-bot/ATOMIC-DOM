#!/bin/bash
# ATOMIC EXPERT: arch-design-patterns | VERSION: 1.0.0 | STATUS: FROZEN
EXPERT_ID="arch-design-patterns"
EXPERT_TITLE="Design Patterns Expert"
EXPERT_JOB="Apply GoF patterns, SOLID principles, and architectural patterns to software design"
EXPERT_PARENT="ProgrammingMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "pattern" "design" "singleton" "factory" "abstract" "builder" "prototype"
  "adapter" "bridge" "composite" "decorator" "facade" "flyweight" "proxy"
  "observer" "strategy" "command" "iterator" "mediator" "memento" "state"
  "template" "visitor" "solid" "dependency" "injection" "inversion"
)

NGRAM_2=(
  "design pattern" "singleton pattern" "factory pattern" "abstract factory"
  "builder pattern" "adapter pattern" "decorator pattern" "observer pattern"
  "strategy pattern" "command pattern" "dependency injection" "solid principles"
  "single responsibility" "open closed" "liskov substitution" "interface segregation"
  "dependency inversion" "creational pattern" "structural pattern" "behavioral pattern"
)

NGRAM_3=(
  "implement design pattern" "apply solid principles" "use factory pattern"
  "refactor using pattern" "dependency injection container"
)

WEIGHT_ACTIVATION=0.58
declare -A WEIGHT_AFFINITY=(
  ["pattern"]=0.88 ["design"]=0.75 ["singleton"]=0.92 ["factory"]=0.90
  ["observer"]=0.90 ["strategy"]=0.90 ["decorator"]=0.88 ["adapter"]=0.85
  ["solid"]=0.92 ["dependency"]=0.80 ["injection"]=0.85 ["inversion"]=0.82
)
WEIGHT_CONFIDENCE_MIN=0.72
WEIGHT_CONFIDENCE_MAX=0.95
WEIGHT_FLARE=0.20
declare -A FLARE_SECONDARY=(["arch-clean-architecture"]=0.40 ["arch-domain-driven"]=0.35 ["lang-java-core"]=0.30)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; esac
