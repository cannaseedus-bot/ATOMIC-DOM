#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# ATOMIC EXPERT: math-algebra-linear
# VERSION: 1.0.0
# STATUS: FROZEN
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# SECTION 1: IDENTITY (FROZEN)
# ─────────────────────────────────────────────────────────────────

EXPERT_ID="math-algebra-linear"
EXPERT_TITLE="Linear Algebra Expert"
EXPERT_JOB="Solve linear algebra operations including matrices, vectors, linear systems, eigenvalues, and transformations"
EXPERT_PARENT="MathMicroAtomic"
EXPERT_VERSION="1.0.0"

# ─────────────────────────────────────────────────────────────────
# SECTION 2: N-GRAM POOL (MODIFIABLE)
# ─────────────────────────────────────────────────────────────────

# Domain vocabulary (unigrams)
NGRAM_1=(
  "matrix"
  "vector"
  "determinant"
  "eigenvalue"
  "eigenvector"
  "transpose"
  "inverse"
  "rank"
  "trace"
  "dot"
  "cross"
  "span"
  "basis"
  "dimension"
  "nullspace"
  "rowspace"
  "columnspace"
  "orthogonal"
  "orthonormal"
  "projection"
  "norm"
  "scalar"
  "linear"
  "transformation"
  "decomposition"
)

# Operation patterns (bigrams)
NGRAM_2=(
  "matrix multiplication"
  "matrix inverse"
  "matrix transpose"
  "determinant calculation"
  "eigenvalue decomposition"
  "eigenvector calculation"
  "vector addition"
  "vector subtraction"
  "scalar multiplication"
  "dot product"
  "cross product"
  "linear transformation"
  "linear combination"
  "linear independence"
  "linear system"
  "gaussian elimination"
  "row reduction"
  "lu decomposition"
  "qr factorization"
  "svd decomposition"
  "gram schmidt"
  "change basis"
  "null space"
  "column space"
  "row space"
)

# Extended patterns (trigrams)
NGRAM_3=(
  "solve linear system"
  "find eigenvalues eigenvectors"
  "compute matrix determinant"
  "calculate dot product"
  "calculate cross product"
  "perform matrix multiplication"
  "apply linear transformation"
  "reduce row echelon"
  "reduced row echelon"
  "orthogonal basis construction"
  "orthonormal basis construction"
  "singular value decomposition"
  "principal component analysis"
  "least squares solution"
  "project onto subspace"
  "find matrix inverse"
  "compute matrix rank"
)

# ─────────────────────────────────────────────────────────────────
# SECTION 3: TENSOR WEIGHTS (MODIFIABLE)
# ─────────────────────────────────────────────────────────────────

# Activation threshold (0.0 - 1.0)
WEIGHT_ACTIVATION=0.60

# Context affinity scores
declare -A WEIGHT_AFFINITY=(
  ["matrix"]=0.95
  ["vector"]=0.90
  ["linear"]=0.85
  ["algebra"]=0.92
  ["eigenvalue"]=0.98
  ["eigenvector"]=0.98
  ["determinant"]=0.95
  ["transpose"]=0.88
  ["inverse"]=0.90
  ["rank"]=0.80
  ["trace"]=0.85
  ["dot"]=0.75
  ["cross"]=0.75
  ["span"]=0.82
  ["basis"]=0.88
  ["orthogonal"]=0.85
  ["decomposition"]=0.80
  ["solve"]=0.65
  ["calculate"]=0.55
  ["compute"]=0.55
  ["find"]=0.50
)

# Output confidence bounds
WEIGHT_CONFIDENCE_MIN=0.70
WEIGHT_CONFIDENCE_MAX=0.98

# Topology flare configuration
WEIGHT_FLARE=0.15

declare -A FLARE_SECONDARY=(
  ["math-calculus"]=0.25
  ["math-statistics"]=0.20
  ["lang-python"]=0.30
  ["lang-matlab"]=0.25
  ["data-numpy"]=0.35
)

# ─────────────────────────────────────────────────────────────────
# SECTION 4: OUTPUT TEMPLATES (MODIFIABLE)
# ─────────────────────────────────────────────────────────────────

TEMPLATE_MATRIX_MULT="Matrix multiplication A×B:
- Dimensions: A(m×n) × B(n×p) = C(m×p)
- Element C[i,j] = sum(A[i,k] × B[k,j]) for k=1 to n"

TEMPLATE_DETERMINANT="Determinant calculation:
- 2×2: det(A) = ad - bc
- 3×3: Use cofactor expansion
- n×n: Use LU decomposition"

TEMPLATE_EIGENVALUE="Eigenvalue problem Av = λv:
1. Solve det(A - λI) = 0 for eigenvalues λ
2. For each λ, solve (A - λI)v = 0 for eigenvectors v"

TEMPLATE_INVERSE="Matrix inverse A⁻¹:
- Condition: det(A) ≠ 0
- Method: Gauss-Jordan or adjugate/determinant
- Property: A × A⁻¹ = I"

TEMPLATE_LINEAR_SYSTEM="Solving Ax = b:
1. Form augmented matrix [A|b]
2. Row reduce to RREF
3. Back-substitute for solution
- Unique: rank(A) = rank([A|b]) = n
- Infinite: rank(A) = rank([A|b]) < n
- None: rank(A) < rank([A|b])"

# ─────────────────────────────────────────────────────────────────
# SECTION 5: SANDBOX BOUNDARY (DO NOT MODIFY)
# ─────────────────────────────────────────────────────────────────

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true
SANDBOX_NO_WRITE=true

# ─────────────────────────────────────────────────────────────────
# SECTION 6: ACTIVATION FUNCTIONS
# ─────────────────────────────────────────────────────────────────

# Tokenize input to lowercase words
tokenize() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '
}

# Calculate activation score from input
calculate_activation() {
  local input=$(tokenize "$1")
  local score=0
  local matches=0
  local total_weight=0

  # Check unigrams
  for gram in "${NGRAM_1[@]}"; do
    if [[ " $input " == *" $gram "* ]]; then
      local weight=${WEIGHT_AFFINITY[$gram]:-0.5}
      score=$(echo "$score + $weight" | bc -l)
      ((matches++))
    fi
  done

  # Check bigrams
  for gram in "${NGRAM_2[@]}"; do
    if [[ "$input" == *"$gram"* ]]; then
      score=$(echo "$score + 0.8" | bc -l)
      ((matches++))
    fi
  done

  # Normalize by match count
  if [ $matches -gt 0 ]; then
    score=$(echo "scale=3; $score / $matches" | bc -l)
  else
    score=0
  fi

  echo "$score"
}

# Check if expert should activate
should_activate() {
  local score=$(calculate_activation "$1")
  local result=$(echo "$score >= $WEIGHT_ACTIVATION" | bc -l)
  if [ "$result" -eq 1 ]; then
    echo "ACTIVATE:$score"
  else
    echo "DORMANT:$score"
  fi
}

# Get activation status as JSON
get_status() {
  local input="$1"
  local score=$(calculate_activation "$input")
  local active=$(echo "$score >= $WEIGHT_ACTIVATION" | bc -l)

  cat << EOF
{
  "expert_id": "$EXPERT_ID",
  "expert_title": "$EXPERT_TITLE",
  "activation_score": $score,
  "threshold": $WEIGHT_ACTIVATION,
  "activated": $([ "$active" -eq 1 ] && echo "true" || echo "false"),
  "confidence_range": [$WEIGHT_CONFIDENCE_MIN, $WEIGHT_CONFIDENCE_MAX]
}
EOF
}

# ═══════════════════════════════════════════════════════════════
# MAIN ENTRY POINT
# ═══════════════════════════════════════════════════════════════

case "${1:-status}" in
  activate)
    should_activate "$2"
    ;;
  score)
    calculate_activation "$2"
    ;;
  status)
    get_status "$2"
    ;;
  info)
    echo "Expert: $EXPERT_ID"
    echo "Title: $EXPERT_TITLE"
    echo "Job: $EXPERT_JOB"
    echo "Version: $EXPERT_VERSION"
    echo "Threshold: $WEIGHT_ACTIVATION"
    ;;
  *)
    echo "Usage: $0 {activate|score|status|info} [input]"
    exit 1
    ;;
esac
