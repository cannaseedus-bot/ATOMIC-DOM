#!/bin/bash
# ATOMIC EXPERT: data-pandas-core | VERSION: 1.0.0 | STATUS: FROZEN
EXPERT_ID="data-pandas-core"
EXPERT_TITLE="Pandas Core Expert"
EXPERT_JOB="Manipulate DataFrames, perform data wrangling, and analyze tabular data with Pandas"
EXPERT_PARENT="CodeGenMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "pandas" "pd" "dataframe" "series" "index" "column" "row" "loc" "iloc"
  "groupby" "merge" "join" "concat" "pivot" "melt" "apply" "map" "transform"
  "fillna" "dropna" "isna" "astype" "value_counts" "describe" "agg" "filter"
  "sort" "query" "read_csv" "to_csv" "read_excel" "to_excel"
)

NGRAM_2=(
  "pandas dataframe" "pd dataframe" "dataframe column" "dataframe index"
  "groupby aggregate" "merge dataframes" "join dataframes" "concat dataframes"
  "pivot table" "melt dataframe" "apply function" "fillna values"
  "drop duplicates" "value counts" "read csv" "to csv" "data wrangling"
)

NGRAM_3=(
  "create pandas dataframe" "groupby and aggregate" "merge two dataframes"
  "read csv into dataframe" "pandas data manipulation"
)

WEIGHT_ACTIVATION=0.55
declare -A WEIGHT_AFFINITY=(
  ["pandas"]=0.98 ["pd"]=0.95 ["dataframe"]=0.95 ["series"]=0.88
  ["groupby"]=0.92 ["merge"]=0.88 ["pivot"]=0.85 ["apply"]=0.80
  ["fillna"]=0.82 ["loc"]=0.85 ["iloc"]=0.85 ["csv"]=0.78
)
WEIGHT_CONFIDENCE_MIN=0.72
WEIGHT_CONFIDENCE_MAX=0.96
WEIGHT_FLARE=0.22
declare -A FLARE_SECONDARY=(["data-numpy-core"]=0.45 ["data-sql-analytics"]=0.35 ["lang-python-core"]=0.35)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]_' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; esac
