#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# ATOMIC EXPERT: math-geometry-euclidean
# VERSION: 1.0.0
# STATUS: FROZEN
# ═══════════════════════════════════════════════════════════════

EXPERT_ID="math-geometry-euclidean"
EXPERT_TITLE="Euclidean Geometry Expert"
EXPERT_JOB="Solve problems involving points, lines, planes, angles, triangles, circles, and geometric proofs"
EXPERT_PARENT="MathMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "geometry" "euclidean" "point" "line" "plane" "angle" "triangle"
  "circle" "polygon" "rectangle" "square" "parallelogram" "trapezoid"
  "rhombus" "pentagon" "hexagon" "congruent" "similar" "parallel"
  "perpendicular" "bisector" "midpoint" "vertex" "vertices" "diagonal"
  "perimeter" "area" "circumference" "radius" "diameter" "chord"
  "tangent" "secant" "arc" "sector" "segment" "proof" "theorem"
)

NGRAM_2=(
  "euclidean geometry" "line segment" "parallel lines" "perpendicular lines"
  "angle bisector" "perpendicular bisector" "triangle congruence"
  "similar triangles" "pythagorean theorem" "area of" "perimeter of"
  "circumference of" "circle theorem" "inscribed angle" "central angle"
  "geometric proof" "two column proof" "coordinate geometry"
)

NGRAM_3=(
  "prove triangles congruent" "find area of" "calculate perimeter"
  "apply pythagorean theorem" "prove lines parallel"
)

WEIGHT_ACTIVATION=0.58

declare -A WEIGHT_AFFINITY=(
  ["geometry"]=0.98 ["euclidean"]=0.95 ["triangle"]=0.88 ["circle"]=0.88
  ["angle"]=0.82 ["parallel"]=0.80 ["perpendicular"]=0.80 ["congruent"]=0.88
  ["similar"]=0.85 ["proof"]=0.78 ["theorem"]=0.75 ["area"]=0.75 ["perimeter"]=0.75
)

WEIGHT_CONFIDENCE_MIN=0.70
WEIGHT_CONFIDENCE_MAX=0.95
WEIGHT_FLARE=0.18

declare -A FLARE_SECONDARY=(
  ["math-geometry-trigonometry"]=0.45 ["math-algebra-linear"]=0.25
)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true
SANDBOX_NO_WRITE=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; *) echo "Usage: $0 {activate|score|status|info} [input]";; esac
