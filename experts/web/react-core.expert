#!/bin/bash
# ATOMIC EXPERT: web-react-core | VERSION: 1.0.0 | STATUS: FROZEN
EXPERT_ID="web-react-core"
EXPERT_TITLE="React Core Expert"
EXPERT_JOB="Build React applications with hooks, components, state management, and modern patterns"
EXPERT_PARENT="WebMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "react" "jsx" "component" "hook" "useState" "useEffect" "useContext"
  "useRef" "useMemo" "useCallback" "useReducer" "props" "state"
  "render" "virtual" "dom" "lifecycle" "mount" "unmount" "update"
  "context" "provider" "consumer" "redux" "zustand" "recoil"
)

NGRAM_2=(
  "react component" "react hook" "useState hook" "useEffect hook"
  "functional component" "class component" "props drilling" "context api"
  "state management" "virtual dom" "jsx syntax" "react router"
  "server component" "client component" "suspense boundary" "error boundary"
)

NGRAM_3=(
  "create react component" "use react hook" "manage react state"
  "implement useEffect cleanup" "react context provider"
)

WEIGHT_ACTIVATION=0.55
declare -A WEIGHT_AFFINITY=(
  ["react"]=0.98 ["jsx"]=0.92 ["component"]=0.85 ["hook"]=0.90
  ["useState"]=0.95 ["useEffect"]=0.95 ["props"]=0.82 ["state"]=0.80
  ["context"]=0.82 ["redux"]=0.85 ["render"]=0.75 ["virtual"]=0.72
)
WEIGHT_CONFIDENCE_MIN=0.72
WEIGHT_CONFIDENCE_MAX=0.96
WEIGHT_FLARE=0.22
declare -A FLARE_SECONDARY=(["lang-typescript-core"]=0.40 ["web-nextjs-core"]=0.45 ["lang-javascript-core"]=0.35)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; esac
