)

# ─────────────────────────────────────────────────────────────────
# SECTION 3: TENSOR WEIGHTS (MODIFIABLE)
# ─────────────────────────────────────────────────────────────────

WEIGHT_ACTIVATION=0.55

declare -A WEIGHT_AFFINITY=(
  ["python"]=0.98
  ["def"]=0.85
  ["class"]=0.85
  ["import"]=0.80
  ["lambda"]=0.88
  ["async"]=0.85
  ["await"]=0.85
  ["list"]=0.70
  ["dict"]=0.75
  ["tuple"]=0.75
  ["comprehension"]=0.90
  ["generator"]=0.88
  ["decorator"]=0.90
  ["self"]=0.82
  ["pip"]=0.85
  ["venv"]=0.85
  ["pytest"]=0.80
  ["type"]=0.65
  ["hints"]=0.70
  ["dataclass"]=0.88
  ["exception"]=0.75
  ["try"]=0.70
  ["except"]=0.70
)

WEIGHT_CONFIDENCE_MIN=0.72
WEIGHT_CONFIDENCE_MAX=0.96

WEIGHT_FLARE=0.20

declare -A FLARE_SECONDARY=(
  ["data-numpy"]=0.40
  ["data-pandas"]=0.35
  ["web-flask"]=0.30
  ["web-django"]=0.30
  ["infra-docker"]=0.25
  ["data-ml"]=0.30
)

# ─────────────────────────────────────────────────────────────────
# SECTION 4: OUTPUT TEMPLATES (MODIFIABLE)
# ─────────────────────────────────────────────────────────────────

TEMPLATE_FUNCTION='def function_name(param1: type, param2: type = default) -> return_type:
    """Docstring describing the function."""
    # Implementation
    return result'

TEMPLATE_CLASS='class ClassName:
    """Docstring describing the class."""

    def __init__(self, param1: type, param2: type):
        self.param1 = param1
        self.param2 = param2

    def method(self) -> return_type:
        """Method docstring."""
        pass'

TEMPLATE_ASYNC='async def async_function(param: type) -> return_type:
    """Async function docstring."""
    result = await some_coroutine()
    return result'

TEMPLATE_COMPREHENSION='# List comprehension
result = [expression for item in iterable if condition]

# Dict comprehension
result = {key: value for item in iterable if condition}

# Generator expression
result = (expression for item in iterable if condition)'

TEMPLATE_CONTEXT_MANAGER='# Using context manager
with open("file.txt", "r") as f:
    content = f.read()

# Creating context manager
from contextlib import contextmanager

@contextmanager
def my_context():
    # Setup
    yield resource
    # Cleanup'

TEMPLATE_EXCEPTION='try:
    # Code that might raise
    result = risky_operation()
except SpecificError as e:
    # Handle specific error
    logger.error(f"Error: {e}")
except Exception as e:
    # Handle any other error
    raise
finally:
    # Always execute
    cleanup()'

# ─────────────────────────────────────────────────────────────────
# SECTION 5: SANDBOX BOUNDARY (DO NOT MODIFY)
# ─────────────────────────────────────────────────────────────────

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true
SANDBOX_NO_WRITE=true

# ─────────────────────────────────────────────────────────────────
# SECTION 6: ACTIVATION FUNCTIONS
# ─────────────────────────────────────────────────────────────────

tokenize() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]_' ' '
}

calculate_activation() {
  local input=$(tokenize "$1")
  local score=0
  local matches=0

  for gram in "${NGRAM_1[@]}"; do
    if [[ " $input " == *" $gram "* ]]; then
      local weight=${WEIGHT_AFFINITY[$gram]:-0.5}
      score=$(echo "$score + $weight" | bc -l)
      ((matches++))
    fi
  done

  for gram in "${NGRAM_2[@]}"; do
    if [[ "$input" == *"$gram"* ]]; then
      score=$(echo "$score + 0.85" | bc -l)
      ((matches++))
    fi
  done

  if [ $matches -gt 0 ]; then
    score=$(echo "scale=3; $score / $matches" | bc -l)
  else
    score=0
  fi

  echo "$score"
}

should_activate() {
  local score=$(calculate_activation "$1")
  local result=$(echo "$score >= $WEIGHT_ACTIVATION" | bc -l)
  if [ "$result" -eq 1 ]; then
    echo "ACTIVATE:$score"
  else
    echo "DORMANT:$score"
  fi
}

get_status() {
  local input="$1"
  local score=$(calculate_activation "$input")
  local active=$(echo "$score >= $WEIGHT_ACTIVATION" | bc -l)

  cat << EOF
{
  "expert_id": "$EXPERT_ID",
  "expert_title": "$EXPERT_TITLE",
  "activation_score": $score,
  "threshold": $WEIGHT_ACTIVATION,
  "activated": $([ "$active" -eq 1 ] && echo "true" || echo "false"),
  "confidence_range": [$WEIGHT_CONFIDENCE_MIN, $WEIGHT_CONFIDENCE_MAX]
}
EOF
}

# ═══════════════════════════════════════════════════════════════
# MAIN ENTRY POINT
# ═══════════════════════════════════════════════════════════════

case "${1:-status}" in
  activate)
    should_activate "$2"
    ;;
  score)
    calculate_activation "$2"
    ;;
  status)
    get_status "$2"
    ;;
  info)
    echo "Expert: $EXPERT_ID"
    echo "Title: $EXPERT_TITLE"
    echo "Job: $EXPERT_JOB"
    echo "Version: $EXPERT_VERSION"
    echo "Threshold: $WEIGHT_ACTIVATION"
    ;;
  *)
    echo "Usage: $0 {activate|score|status|info} [input]"
    exit 1
    ;;
esac
