  "complete the square"
)

# ─────────────────────────────────────────────────────────────────
# SECTION 3: TENSOR WEIGHTS (MODIFIABLE)
# ─────────────────────────────────────────────────────────────────

WEIGHT_ACTIVATION=0.60

declare -A WEIGHT_AFFINITY=(
  ["polynomial"]=0.98
  ["factor"]=0.92
  ["roots"]=0.88
  ["zeros"]=0.88
  ["quadratic"]=0.90
  ["cubic"]=0.88
  ["expand"]=0.85
  ["coefficient"]=0.80
  ["degree"]=0.78
  ["binomial"]=0.85
  ["trinomial"]=0.85
  ["synthetic"]=0.82
  ["remainder"]=0.75
  ["divisor"]=0.72
  ["equation"]=0.70
  ["solve"]=0.68
  ["find"]=0.55
)

WEIGHT_CONFIDENCE_MIN=0.70
WEIGHT_CONFIDENCE_MAX=0.96

WEIGHT_FLARE=0.18

declare -A FLARE_SECONDARY=(
  ["math-algebra-linear"]=0.35
  ["math-calculus-derivative"]=0.20
  ["math-number-theory"]=0.25
)

# ─────────────────────────────────────────────────────────────────
# SECTION 4: OUTPUT TEMPLATES (MODIFIABLE)
# ─────────────────────────────────────────────────────────────────

TEMPLATE_QUADRATIC='Quadratic Formula: x = (-b ± √(b²-4ac)) / 2a
For ax² + bx + c = 0:
- Discriminant: Δ = b² - 4ac
- If Δ > 0: Two real roots
- If Δ = 0: One repeated root
- If Δ < 0: Two complex roots'

TEMPLATE_FACTORING='Factoring strategies:
1. GCF (Greatest Common Factor)
2. Difference of squares: a² - b² = (a+b)(a-b)
3. Sum of cubes: a³ + b³ = (a+b)(a²-ab+b²)
4. Difference of cubes: a³ - b³ = (a-b)(a²+ab+b²)
5. Grouping for 4+ terms
6. Trial and error for trinomials'

TEMPLATE_SYNTHETIC='Synthetic Division:
1. Write coefficients in order
2. Bring down leading coefficient
3. Multiply by divisor root, add to next
4. Repeat until remainder found
5. Result: quotient + remainder/(x-r)'

TEMPLATE_RATIONAL_ROOTS='Rational Root Theorem:
If p/q is a root of polynomial with integer coefficients:
- p divides the constant term
- q divides the leading coefficient
Test all combinations ±p/q'

# ─────────────────────────────────────────────────────────────────
# SECTION 5: SANDBOX BOUNDARY (DO NOT MODIFY)
# ─────────────────────────────────────────────────────────────────

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true
SANDBOX_NO_WRITE=true

# ─────────────────────────────────────────────────────────────────
# SECTION 6: ACTIVATION FUNCTIONS
# ─────────────────────────────────────────────────────────────────

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }

calculate_activation() {
  local input=$(tokenize "$1")
  local score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do
    if [[ " $input " == *" $gram "* ]]; then
      local w=${WEIGHT_AFFINITY[$gram]:-0.5}
      score=$(echo "$score + $w" | bc -l); ((matches++))
    fi
  done
  for gram in "${NGRAM_2[@]}"; do
    if [[ "$input" == *"$gram"* ]]; then
      score=$(echo "$score + 0.8" | bc -l); ((matches++))
    fi
  done
  [ $matches -gt 0 ] && score=$(echo "scale=3; $score / $matches" | bc -l) || score=0
  echo "$score"
}

should_activate() {
  local score=$(calculate_activation "$1")
  local result=$(echo "$score >= $WEIGHT_ACTIVATION" | bc -l)
  [ "$result" -eq 1 ] && echo "ACTIVATE:$score" || echo "DORMANT:$score"
}

get_status() {
  local input="$1" score=$(calculate_activation "$input")
  local active=$(echo "$score >= $WEIGHT_ACTIVATION" | bc -l)
  cat << EOF
{"expert_id":"$EXPERT_ID","activation_score":$score,"threshold":$WEIGHT_ACTIVATION,"activated":$([ "$active" -eq 1 ] && echo "true" || echo "false")}
EOF
}

case "${1:-status}" in
  activate) should_activate "$2" ;;
  score) calculate_activation "$2" ;;
  status) get_status "$2" ;;
  info) echo "Expert: $EXPERT_ID"; echo "Title: $EXPERT_TITLE"; echo "Job: $EXPERT_JOB" ;;
  *) echo "Usage: $0 {activate|score|status|info} [input]"; exit 1 ;;
esac
