#!/bin/bash
# ATOMIC EXPERT: data-numpy-core | VERSION: 1.0.0 | STATUS: FROZEN
EXPERT_ID="data-numpy-core"
EXPERT_TITLE="NumPy Core Expert"
EXPERT_JOB="Perform numerical computing with NumPy arrays, broadcasting, and vectorized operations"
EXPERT_PARENT="CodeGenMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "numpy" "np" "array" "ndarray" "shape" "dtype" "reshape" "broadcast"
  "vectorize" "axis" "slice" "index" "fancy" "boolean" "mask" "where"
  "arange" "linspace" "zeros" "ones" "empty" "random" "dot" "matmul"
  "transpose" "flatten" "ravel" "stack" "concatenate" "split"
)

NGRAM_2=(
  "numpy array" "np array" "array shape" "array dtype" "reshape array"
  "broadcasting rule" "vectorized operation" "boolean indexing" "fancy indexing"
  "array slicing" "dot product" "matrix multiplication" "element wise"
  "np random" "np zeros" "np ones" "np arange" "np linspace"
)

NGRAM_3=(
  "create numpy array" "reshape numpy array" "numpy broadcasting rules"
  "vectorize numpy operation" "numpy matrix multiplication"
)

WEIGHT_ACTIVATION=0.55
declare -A WEIGHT_AFFINITY=(
  ["numpy"]=0.98 ["np"]=0.95 ["array"]=0.85 ["ndarray"]=0.92
  ["broadcast"]=0.90 ["vectorize"]=0.88 ["reshape"]=0.82 ["dtype"]=0.80
  ["axis"]=0.78 ["matmul"]=0.85 ["dot"]=0.80 ["slice"]=0.72
)
WEIGHT_CONFIDENCE_MIN=0.72
WEIGHT_CONFIDENCE_MAX=0.96
WEIGHT_FLARE=0.22
declare -A FLARE_SECONDARY=(["data-pandas-core"]=0.45 ["math-algebra-linear"]=0.40 ["lang-python-core"]=0.35)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; esac
