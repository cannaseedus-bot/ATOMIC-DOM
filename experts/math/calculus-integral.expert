#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# ATOMIC EXPERT: math-calculus-integral
# VERSION: 1.0.0
# STATUS: FROZEN
# ═══════════════════════════════════════════════════════════════

EXPERT_ID="math-calculus-integral"
EXPERT_TITLE="Calculus Integrals Expert"
EXPERT_JOB="Compute definite and indefinite integrals, apply integration techniques, and solve area/volume problems"
EXPERT_PARENT="MathMicroAtomic"
EXPERT_VERSION="1.0.0"

# ─────────────────────────────────────────────────────────────────
# SECTION 2: N-GRAM POOL
# ─────────────────────────────────────────────────────────────────

NGRAM_1=(
  "integral"
  "integrate"
  "integration"
  "antiderivative"
  "area"
  "volume"
  "definite"
  "indefinite"
  "bounds"
  "limits"
  "substitution"
  "parts"
  "partial"
  "fractions"
  "trigonometric"
  "improper"
  "convergent"
  "divergent"
  "riemann"
  "sum"
  "accumulation"
  "fundamental"
  "theorem"
  "constant"
)

NGRAM_2=(
  "find integral"
  "compute integral"
  "integral of"
  "integrate the"
  "definite integral"
  "indefinite integral"
  "integration by parts"
  "u substitution"
  "trig substitution"
  "partial fractions"
  "improper integral"
  "area under"
  "area between"
  "volume of revolution"
  "disk method"
  "shell method"
  "washer method"
  "fundamental theorem"
  "riemann sum"
  "double integral"
  "triple integral"
  "line integral"
  "surface integral"
)

NGRAM_3=(
  "find the integral"
  "compute the integral"
  "evaluate the integral"
  "integration by parts"
  "area under curve"
  "area between curves"
  "volume of revolution"
  "fundamental theorem calculus"
  "apply u substitution"
  "use partial fractions"
)

# ─────────────────────────────────────────────────────────────────
# SECTION 3: TENSOR WEIGHTS
# ─────────────────────────────────────────────────────────────────

WEIGHT_ACTIVATION=0.58

declare -A WEIGHT_AFFINITY=(
  ["integral"]=0.98
  ["integrate"]=0.96
  ["integration"]=0.96
  ["antiderivative"]=0.95
  ["definite"]=0.85
  ["indefinite"]=0.85
  ["substitution"]=0.82
  ["parts"]=0.78
  ["area"]=0.75
  ["volume"]=0.78
  ["bounds"]=0.72
  ["improper"]=0.80
  ["riemann"]=0.85
  ["fundamental"]=0.75
  ["accumulation"]=0.78
)

WEIGHT_CONFIDENCE_MIN=0.72
WEIGHT_CONFIDENCE_MAX=0.97

WEIGHT_FLARE=0.20

declare -A FLARE_SECONDARY=(
  ["math-calculus-derivative"]=0.45
  ["math-calculus-differential"]=0.35
  ["math-algebra-polynomial"]=0.20
  ["lang-python"]=0.20
)

# ─────────────────────────────────────────────────────────────────
# SECTION 4: OUTPUT TEMPLATES
# ─────────────────────────────────────────────────────────────────

TEMPLATE_POWER='Power Rule: ∫xⁿ dx = xⁿ⁺¹/(n+1) + C  (n ≠ -1)'

TEMPLATE_SUBSTITUTION='U-Substitution:
1. Choose u = g(x)
2. Find du = g'\''(x)dx
3. Substitute and integrate
4. Replace u with original expression'

TEMPLATE_PARTS='Integration by Parts: ∫u dv = uv - ∫v du
LIATE priority: Logs, Inverse trig, Algebraic, Trig, Exponential'

TEMPLATE_FUNDAMENTAL='Fundamental Theorem of Calculus:
Part 1: d/dx[∫ₐˣ f(t)dt] = f(x)
Part 2: ∫ₐᵇ f(x)dx = F(b) - F(a) where F'\''(x) = f(x)'

TEMPLATE_AREA='Area between curves:
A = ∫ₐᵇ [f(x) - g(x)] dx
where f(x) ≥ g(x) on [a,b]'

# ─────────────────────────────────────────────────────────────────
# SECTION 5: SANDBOX BOUNDARY
# ─────────────────────────────────────────────────────────────────

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true
SANDBOX_NO_WRITE=true

# ─────────────────────────────────────────────────────────────────
# SECTION 6: ACTIVATION FUNCTIONS
# ─────────────────────────────────────────────────────────────────

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }

calculate_activation() {
  local input=$(tokenize "$1")
  local score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do
    if [[ " $input " == *" $gram "* ]]; then
      local w=${WEIGHT_AFFINITY[$gram]:-0.5}
      score=$(echo "$score + $w" | bc -l); ((matches++))
    fi
  done
  for gram in "${NGRAM_2[@]}"; do
    if [[ "$input" == *"$gram"* ]]; then
      score=$(echo "$score + 0.85" | bc -l); ((matches++))
    fi
  done
  [ $matches -gt 0 ] && score=$(echo "scale=3; $score / $matches" | bc -l) || score=0
  echo "$score"
}

should_activate() {
  local score=$(calculate_activation "$1")
  local result=$(echo "$score >= $WEIGHT_ACTIVATION" | bc -l)
  [ "$result" -eq 1 ] && echo "ACTIVATE:$score" || echo "DORMANT:$score"
}

get_status() {
  local input="$1" score=$(calculate_activation "$input")
  local active=$(echo "$score >= $WEIGHT_ACTIVATION" | bc -l)
  cat << EOF
{"expert_id":"$EXPERT_ID","activation_score":$score,"threshold":$WEIGHT_ACTIVATION,"activated":$([ "$active" -eq 1 ] && echo "true" || echo "false")}
EOF
}

case "${1:-status}" in
  activate) should_activate "$2" ;;
  score) calculate_activation "$2" ;;
  status) get_status "$2" ;;
  info) echo "Expert: $EXPERT_ID"; echo "Title: $EXPERT_TITLE"; echo "Job: $EXPERT_JOB" ;;
  *) echo "Usage: $0 {activate|score|status|info} [input]"; exit 1 ;;
esac
