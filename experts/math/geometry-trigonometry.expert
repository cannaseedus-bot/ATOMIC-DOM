#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# ATOMIC EXPERT: math-geometry-trigonometry
# VERSION: 1.0.0
# STATUS: FROZEN
# ═══════════════════════════════════════════════════════════════

EXPERT_ID="math-geometry-trigonometry"
EXPERT_TITLE="Trigonometry Expert"
EXPERT_JOB="Solve problems with trigonometric functions, identities, equations, and triangle measurements"
EXPERT_PARENT="MathMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "trigonometry" "trig" "sine" "cosine" "tangent" "sin" "cos" "tan"
  "secant" "cosecant" "cotangent" "sec" "csc" "cot" "angle" "radian"
  "degree" "unit" "circle" "identity" "inverse" "arcsin" "arccos"
  "arctan" "amplitude" "period" "phase" "shift" "pythagorean"
  "law" "sines" "cosines" "sohcahtoa" "hypotenuse" "opposite" "adjacent"
)

NGRAM_2=(
  "trigonometric function" "trig function" "unit circle" "trig identity"
  "pythagorean identity" "double angle" "half angle" "sum difference"
  "law of sines" "law of cosines" "inverse trig" "solve triangle"
  "right triangle" "reference angle" "amplitude period" "phase shift"
  "trig equation" "verify identity"
)

NGRAM_3=(
  "find the angle" "solve trig equation" "verify trig identity"
  "apply law of sines" "apply law of cosines" "use unit circle"
)

WEIGHT_ACTIVATION=0.58

declare -A WEIGHT_AFFINITY=(
  ["trigonometry"]=0.98 ["trig"]=0.95 ["sine"]=0.90 ["cosine"]=0.90
  ["tangent"]=0.90 ["sin"]=0.88 ["cos"]=0.88 ["tan"]=0.88
  ["identity"]=0.85 ["radian"]=0.82 ["degree"]=0.70 ["hypotenuse"]=0.88
  ["sohcahtoa"]=0.95 ["arcsin"]=0.90 ["arccos"]=0.90 ["arctan"]=0.90
)

WEIGHT_CONFIDENCE_MIN=0.72
WEIGHT_CONFIDENCE_MAX=0.96
WEIGHT_FLARE=0.18

declare -A FLARE_SECONDARY=(
  ["math-geometry-euclidean"]=0.40 ["math-calculus-derivative"]=0.30
  ["math-algebra-polynomial"]=0.20
)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true
SANDBOX_NO_WRITE=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; *) echo "Usage: $0 {activate|score|status|info} [input]";; esac
