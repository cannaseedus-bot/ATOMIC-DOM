#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# ATOMIC EXPERT: math-calculus-derivative
# VERSION: 1.0.0
# STATUS: FROZEN
# ═══════════════════════════════════════════════════════════════

EXPERT_ID="math-calculus-derivative"
EXPERT_TITLE="Calculus Derivatives Expert"
EXPERT_JOB="Compute derivatives, apply differentiation rules, and solve rate of change problems"
EXPERT_PARENT="MathMicroAtomic"
EXPERT_VERSION="1.0.0"

# ─────────────────────────────────────────────────────────────────
# SECTION 2: N-GRAM POOL
# ─────────────────────────────────────────────────────────────────

NGRAM_1=(
  "derivative"
  "differentiate"
  "differentiation"
  "slope"
  "tangent"
  "rate"
  "change"
  "gradient"
  "limit"
  "instantaneous"
  "velocity"
  "acceleration"
  "maximum"
  "minimum"
  "extrema"
  "critical"
  "inflection"
  "concave"
  "convex"
  "chain"
  "product"
  "quotient"
  "implicit"
  "partial"
  "gradient"
)

NGRAM_2=(
  "take derivative"
  "find derivative"
  "derivative of"
  "chain rule"
  "product rule"
  "quotient rule"
  "power rule"
  "rate of change"
  "instantaneous rate"
  "tangent line"
  "slope of"
  "critical point"
  "critical points"
  "local maximum"
  "local minimum"
  "global maximum"
  "global minimum"
  "inflection point"
  "second derivative"
  "first derivative"
  "implicit differentiation"
  "partial derivative"
  "directional derivative"
  "higher order"
)

NGRAM_3=(
  "find the derivative"
  "take the derivative"
  "apply chain rule"
  "apply product rule"
  "apply quotient rule"
  "find critical points"
  "find local extrema"
  "rate of change of"
  "slope of tangent"
  "second derivative test"
  "first derivative test"
  "implicit differentiation of"
)

# ─────────────────────────────────────────────────────────────────
# SECTION 3: TENSOR WEIGHTS
# ─────────────────────────────────────────────────────────────────

WEIGHT_ACTIVATION=0.58

declare -A WEIGHT_AFFINITY=(
  ["derivative"]=0.98
  ["differentiate"]=0.96
  ["differentiation"]=0.96
  ["chain"]=0.75
  ["product"]=0.70
  ["quotient"]=0.70
  ["tangent"]=0.85
  ["slope"]=0.80
  ["rate"]=0.75
  ["change"]=0.65
  ["critical"]=0.78
  ["extrema"]=0.82
  ["maximum"]=0.75
  ["minimum"]=0.75
  ["inflection"]=0.80
  ["implicit"]=0.85
  ["partial"]=0.88
  ["gradient"]=0.85
)

WEIGHT_CONFIDENCE_MIN=0.72
WEIGHT_CONFIDENCE_MAX=0.97

WEIGHT_FLARE=0.20

declare -A FLARE_SECONDARY=(
  ["math-calculus-integral"]=0.45
  ["math-calculus-differential"]=0.40
  ["math-algebra-polynomial"]=0.25
  ["lang-python"]=0.20
)

# ─────────────────────────────────────────────────────────────────
# SECTION 4: OUTPUT TEMPLATES
# ─────────────────────────────────────────────────────────────────

TEMPLATE_POWER='Power Rule: d/dx[xⁿ] = n·xⁿ⁻¹'

TEMPLATE_CHAIN='Chain Rule: d/dx[f(g(x))] = f'\''(g(x)) · g'\''(x)
"Derivative of outside × derivative of inside"'

TEMPLATE_PRODUCT='Product Rule: d/dx[f(x)·g(x)] = f'\''(x)·g(x) + f(x)·g'\''(x)
"First times derivative of second + second times derivative of first"'

TEMPLATE_QUOTIENT='Quotient Rule: d/dx[f(x)/g(x)] = [f'\''(x)·g(x) - f(x)·g'\''(x)] / [g(x)]²
"Low d-high minus high d-low over low squared"'

TEMPLATE_CRITICAL='Critical Points:
1. Find f'\''(x)
2. Set f'\''(x) = 0 and solve
3. Find where f'\''(x) is undefined
4. Test intervals or use second derivative test'

# ─────────────────────────────────────────────────────────────────
# SECTION 5: SANDBOX BOUNDARY
# ─────────────────────────────────────────────────────────────────

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true
SANDBOX_NO_WRITE=true

# ─────────────────────────────────────────────────────────────────
# SECTION 6: ACTIVATION FUNCTIONS
# ─────────────────────────────────────────────────────────────────

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }

calculate_activation() {
  local input=$(tokenize "$1")
  local score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do
    if [[ " $input " == *" $gram "* ]]; then
      local w=${WEIGHT_AFFINITY[$gram]:-0.5}
      score=$(echo "$score + $w" | bc -l); ((matches++))
    fi
  done
  for gram in "${NGRAM_2[@]}"; do
    if [[ "$input" == *"$gram"* ]]; then
      score=$(echo "$score + 0.85" | bc -l); ((matches++))
    fi
  done
  [ $matches -gt 0 ] && score=$(echo "scale=3; $score / $matches" | bc -l) || score=0
  echo "$score"
}

should_activate() {
  local score=$(calculate_activation "$1")
  local result=$(echo "$score >= $WEIGHT_ACTIVATION" | bc -l)
  [ "$result" -eq 1 ] && echo "ACTIVATE:$score" || echo "DORMANT:$score"
}

get_status() {
  local input="$1" score=$(calculate_activation "$input")
  local active=$(echo "$score >= $WEIGHT_ACTIVATION" | bc -l)
  cat << EOF
{"expert_id":"$EXPERT_ID","activation_score":$score,"threshold":$WEIGHT_ACTIVATION,"activated":$([ "$active" -eq 1 ] && echo "true" || echo "false")}
EOF
}

case "${1:-status}" in
  activate) should_activate "$2" ;;
  score) calculate_activation "$2" ;;
  status) get_status "$2" ;;
  info) echo "Expert: $EXPERT_ID"; echo "Title: $EXPERT_TITLE"; echo "Job: $EXPERT_JOB" ;;
  *) echo "Usage: $0 {activate|score|status|info} [input]"; exit 1 ;;
esac
