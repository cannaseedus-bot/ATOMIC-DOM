#!/bin/bash
# ATOMIC EXPERT: docs-technical-writing | VERSION: 1.0.0 | STATUS: FROZEN
EXPERT_ID="docs-technical-writing"
EXPERT_TITLE="Technical Writing Expert"
EXPERT_JOB="Write clear technical documentation, guides, and specifications"
EXPERT_PARENT="OutputMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "documentation" "document" "guide" "tutorial" "readme" "specification"
  "spec" "reference" "manual" "api" "docs" "write" "writing" "technical"
  "explain" "describe" "overview" "introduction" "getting" "started"
  "example" "usage" "install" "configure" "troubleshoot"
)

NGRAM_2=(
  "technical documentation" "write documentation" "documentation guide"
  "getting started" "api reference" "user guide" "developer guide"
  "installation guide" "configuration guide" "troubleshooting guide"
  "code example" "usage example" "readme file" "specification document"
)

NGRAM_3=(
  "write technical documentation" "create user guide" "document the api"
  "write getting started" "add code examples"
)

WEIGHT_ACTIVATION=0.55
declare -A WEIGHT_AFFINITY=(
  ["documentation"]=0.95 ["document"]=0.88 ["guide"]=0.85 ["tutorial"]=0.88
  ["readme"]=0.90 ["specification"]=0.85 ["technical"]=0.80 ["writing"]=0.78
  ["explain"]=0.75 ["example"]=0.78 ["api"]=0.72 ["docs"]=0.90
)
WEIGHT_CONFIDENCE_MIN=0.70
WEIGHT_CONFIDENCE_MAX=0.94
WEIGHT_FLARE=0.18
declare -A FLARE_SECONDARY=(["docs-api-documentation"]=0.45 ["docs-readme-guide"]=0.40)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; esac
