#!/bin/bash
# ATOMIC EXPERT: web-css-layout | VERSION: 1.0.0 | STATUS: FROZEN
EXPERT_ID="web-css-layout"
EXPERT_TITLE="CSS Layout Expert"
EXPERT_JOB="Design responsive layouts with Flexbox, Grid, and modern CSS techniques"
EXPERT_PARENT="WebMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "css" "layout" "flexbox" "flex" "grid" "display" "position"
  "responsive" "media" "query" "container" "box" "margin" "padding"
  "width" "height" "min" "max" "auto" "gap" "align" "justify"
  "center" "column" "row" "wrap" "order" "grow" "shrink" "basis"
)

NGRAM_2=(
  "css layout" "flexbox layout" "grid layout" "display flex" "display grid"
  "media query" "responsive design" "container query" "box model"
  "align items" "justify content" "flex direction" "grid template"
  "grid area" "gap property" "min width" "max width" "aspect ratio"
)

NGRAM_3=(
  "create responsive layout" "use css grid" "center element with"
  "responsive flexbox layout" "css grid template"
)

WEIGHT_ACTIVATION=0.55
declare -A WEIGHT_AFFINITY=(
  ["css"]=0.90 ["layout"]=0.88 ["flexbox"]=0.95 ["flex"]=0.90
  ["grid"]=0.95 ["responsive"]=0.88 ["media"]=0.80 ["container"]=0.75
  ["align"]=0.78 ["justify"]=0.78 ["gap"]=0.80 ["display"]=0.72
)
WEIGHT_CONFIDENCE_MIN=0.72
WEIGHT_CONFIDENCE_MAX=0.95
WEIGHT_FLARE=0.20
declare -A FLARE_SECONDARY=(["web-html-semantic"]=0.35 ["web-css-animation"]=0.40)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; esac
