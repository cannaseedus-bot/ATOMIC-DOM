# ─────────────────────────────────────────────────────────────────
# SECTION 1: IDENTITY (FROZEN)
# ─────────────────────────────────────────────────────────────────

EXPERT_ID="math-algebra-polynomial"
EXPERT_TITLE="Polynomial Algebra Expert"
EXPERT_JOB="Factor, expand, and solve polynomial equations including roots, coefficients, and polynomial operations"
EXPERT_PARENT="MathMicroAtomic"
EXPERT_VERSION="1.0.0"

# ─────────────────────────────────────────────────────────────────
# SECTION 2: N-GRAM POOL (MODIFIABLE)
# ─────────────────────────────────────────────────────────────────

NGRAM_1=(
  "polynomial"
  "factor"
