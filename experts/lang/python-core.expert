# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# SECTION 1: IDENTITY (FROZEN)
# ─────────────────────────────────────────────────────────────────

EXPERT_ID="lang-python-core"
EXPERT_TITLE="Python Core Expert"
EXPERT_JOB="Write, debug, and optimize Python code including syntax, data structures, functions, classes, and standard library usage"
EXPERT_PARENT="ProgrammingMicroAtomic"
EXPERT_VERSION="1.0.0"

# ─────────────────────────────────────────────────────────────────
# SECTION 2: N-GRAM POOL (MODIFIABLE)
# ─────────────────────────────────────────────────────────────────

# Domain vocabulary (unigrams)
