#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# ATOMIC EXPERT: lang-java-core
# VERSION: 1.0.0
# STATUS: FROZEN
# ═══════════════════════════════════════════════════════════════

EXPERT_ID="lang-java-core"
EXPERT_TITLE="Java Core Expert"
EXPERT_JOB="Write object-oriented Java with classes, interfaces, generics, streams, and enterprise patterns"
EXPERT_PARENT="ProgrammingMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "java" "jdk" "jvm" "class" "interface" "abstract" "extends"
  "implements" "override" "public" "private" "protected" "static"
  "final" "void" "new" "this" "super" "package" "import"
  "exception" "throw" "throws" "try" "catch" "finally" "generic"
  "stream" "lambda" "optional" "collection" "list" "map" "set"
  "arraylist" "hashmap" "thread" "synchronized" "volatile"
)

NGRAM_2=(
  "java code" "java class" "java interface" "abstract class"
  "generic type" "lambda expression" "stream api" "optional type"
  "exception handling" "try catch" "throw exception" "thread pool"
  "synchronized block" "collection framework" "arraylist hashmap"
  "spring boot" "maven gradle" "junit test" "design pattern"
)

NGRAM_3=(
  "write java code" "create java class" "implement interface in"
  "use stream api" "handle exception with" "create thread pool"
)

WEIGHT_ACTIVATION=0.55

declare -A WEIGHT_AFFINITY=(
  ["java"]=0.98 ["jdk"]=0.90 ["jvm"]=0.88 ["class"]=0.72
  ["interface"]=0.78 ["abstract"]=0.75 ["extends"]=0.75 ["implements"]=0.78
  ["generic"]=0.82 ["stream"]=0.80 ["lambda"]=0.85 ["optional"]=0.82
  ["exception"]=0.75 ["thread"]=0.78 ["synchronized"]=0.82
)

WEIGHT_CONFIDENCE_MIN=0.70
WEIGHT_CONFIDENCE_MAX=0.96
WEIGHT_FLARE=0.20

declare -A FLARE_SECONDARY=(
  ["lang-kotlin-core"]=0.40 ["arch-design-patterns"]=0.35
  ["infra-docker-core"]=0.25 ["web-api-rest"]=0.30
)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true
SANDBOX_NO_WRITE=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; *) echo "Usage: $0 {activate|score|status|info} [input]";; esac
