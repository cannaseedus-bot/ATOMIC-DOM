#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# ATOMIC EXPERT: lang-typescript-core
# VERSION: 1.0.0
# STATUS: FROZEN
# ═══════════════════════════════════════════════════════════════

EXPERT_ID="lang-typescript-core"
EXPERT_TITLE="TypeScript Core Expert"
EXPERT_JOB="Write type-safe TypeScript code with interfaces, generics, decorators, and advanced type system features"
EXPERT_PARENT="ProgrammingMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "typescript" "ts" "type" "interface" "generic" "generics" "enum"
  "namespace" "module" "declare" "readonly" "partial" "required"
  "pick" "omit" "record" "exclude" "extract" "infer" "keyof"
  "typeof" "mapped" "conditional" "literal" "tuple" "union"
  "intersection" "never" "unknown" "any" "void" "null" "undefined"
  "decorator" "abstract" "implements" "extends" "override"
)

NGRAM_2=(
  "typescript code" "type annotation" "type inference" "interface definition"
  "generic type" "generic function" "type guard" "type assertion"
  "mapped type" "conditional type" "utility type" "union type"
  "intersection type" "literal type" "tuple type" "enum type"
  "type alias" "index signature" "optional property" "readonly property"
  "strict mode" "tsconfig json" "declaration file" "d ts file"
)

NGRAM_3=(
  "write typescript code" "define interface for" "create generic type"
  "implement type guard" "use utility types" "configure tsconfig"
)

WEIGHT_ACTIVATION=0.55

declare -A WEIGHT_AFFINITY=(
  ["typescript"]=0.98 ["ts"]=0.90 ["type"]=0.75 ["interface"]=0.88
  ["generic"]=0.90 ["generics"]=0.90 ["enum"]=0.82 ["decorator"]=0.85
  ["keyof"]=0.92 ["typeof"]=0.85 ["infer"]=0.92 ["mapped"]=0.88
  ["conditional"]=0.82 ["utility"]=0.80 ["union"]=0.78 ["intersection"]=0.80
)

WEIGHT_CONFIDENCE_MIN=0.72
WEIGHT_CONFIDENCE_MAX=0.97
WEIGHT_FLARE=0.22

declare -A FLARE_SECONDARY=(
  ["lang-javascript-core"]=0.50 ["web-react-core"]=0.35 ["web-angular-core"]=0.35
  ["web-nextjs-core"]=0.30 ["arch-design-patterns"]=0.20
)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true
SANDBOX_NO_WRITE=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; *) echo "Usage: $0 {activate|score|status|info} [input]";; esac
