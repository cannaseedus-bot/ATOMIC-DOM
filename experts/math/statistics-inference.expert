#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# ATOMIC EXPERT: math-statistics-inference
# VERSION: 1.0.0
# STATUS: FROZEN
# ═══════════════════════════════════════════════════════════════

EXPERT_ID="math-statistics-inference"
EXPERT_TITLE="Statistical Inference Expert"
EXPERT_JOB="Perform hypothesis testing, estimate parameters, construct confidence intervals, and interpret significance"
EXPERT_PARENT="MathMicroAtomic"
EXPERT_VERSION="1.0.0"

NGRAM_1=(
  "inference" "hypothesis" "test" "significance" "pvalue" "alpha"
  "reject" "null" "alternative" "confidence" "interval" "estimate"
  "estimator" "bias" "unbiased" "consistent" "efficient" "mle"
  "likelihood" "anova" "ttest" "ztest" "chi" "ftest" "power"
  "typeI" "typeII" "error" "critical" "region" "parametric"
)

NGRAM_2=(
  "hypothesis test" "null hypothesis" "alternative hypothesis"
  "significance level" "p value" "confidence interval" "reject null"
  "fail to reject" "type I error" "type II error" "statistical power"
  "maximum likelihood" "point estimate" "interval estimate"
  "t test" "z test" "chi square test" "f test" "anova test"
  "one tailed" "two tailed" "critical value" "test statistic"
)

NGRAM_3=(
  "perform hypothesis test" "calculate p value" "construct confidence interval"
  "reject null hypothesis" "fail to reject null" "determine significance level"
)

WEIGHT_ACTIVATION=0.60

declare -A WEIGHT_AFFINITY=(
  ["inference"]=0.98 ["hypothesis"]=0.95 ["significance"]=0.92
  ["pvalue"]=0.95 ["confidence"]=0.88 ["null"]=0.85 ["alternative"]=0.85
  ["reject"]=0.80 ["anova"]=0.90 ["likelihood"]=0.88
)

WEIGHT_CONFIDENCE_MIN=0.72
WEIGHT_CONFIDENCE_MAX=0.96
WEIGHT_FLARE=0.15

declare -A FLARE_SECONDARY=(
  ["math-statistics-probability"]=0.45 ["data-sklearn"]=0.30
)

SANDBOX_READ_ONLY=true
SANDBOX_ISOLATED=true
SANDBOX_NO_NETWORK=true
SANDBOX_NO_SPAWN=true
SANDBOX_NO_WRITE=true

tokenize() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' '; }
calculate_activation() {
  local input=$(tokenize "$1") score=0 matches=0
  for gram in "${NGRAM_1[@]}"; do [[ " $input " == *" $gram "* ]] && { score=$(echo "$score + ${WEIGHT_AFFINITY[$gram]:-0.5}" | bc -l); ((matches++)); }; done
  for gram in "${NGRAM_2[@]}"; do [[ "$input" == *"$gram"* ]] && { score=$(echo "$score + 0.85" | bc -l); ((matches++)); }; done
  [ $matches -gt 0 ] && echo "scale=3; $score / $matches" | bc -l || echo 0
}
should_activate() { local s=$(calculate_activation "$1"); [ $(echo "$s >= $WEIGHT_ACTIVATION" | bc -l) -eq 1 ] && echo "ACTIVATE:$s" || echo "DORMANT:$s"; }
get_status() { local s=$(calculate_activation "$1"); local a=$(echo "$s >= $WEIGHT_ACTIVATION" | bc -l); echo "{\"expert_id\":\"$EXPERT_ID\",\"activation_score\":$s,\"activated\":$([ "$a" -eq 1 ] && echo true || echo false)}"; }
case "${1:-status}" in activate) should_activate "$2";; score) calculate_activation "$2";; status) get_status "$2";; info) echo "$EXPERT_ID: $EXPERT_TITLE";; *) echo "Usage: $0 {activate|score|status|info} [input]";; esac
